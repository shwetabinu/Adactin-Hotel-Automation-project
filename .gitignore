# Dependencies
node_modules/

# Playwright-bdd generates these from features/ on every run (npx bddgen)
.features-gen/

# Test output
test-results/
playwright-report/
cucumber-report/
blob-report/
playwright/.cache/

# Saved storage states - regenerated by logging in, not source
.auth/

# Local env overrides. .env.build1/.env.build2 stay tracked: the suite reads
# credentials from them and CI has no secrets configured yet.
.env
.env.local
.env.*.local

# OS / editor noise
.DS_Store
**/.DS_Store
*.swp
*.log
npm-debug.log*
